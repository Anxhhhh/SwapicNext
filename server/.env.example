# ─── SWAPIC BACKEND ENVIRONMENT CONFIGURATION ───
# In production, set these variables in your hosting dashboard (e.g. Render / Railway / Cloud Run)

NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# MongoDB Connection String (MongoDB Atlas URI in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/swapic?retryWrites=true&w=majority

# JWT Token Secrets (use long random strings in production)
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars

# Frontend Domain (e.g. https://swapic.vercel.app or http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Firebase Service Account (JSON string or base64) for cloud hosts without file uploads
# Paste your serviceAccountKey.json content directly into this environment variable
FIREBASE_SERVICE_ACCOUNT=

# Razorpay Payment Gateway Keys (rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Verification (SMTP configuration for sending OTP verification codes)
# For Gmail: SMTP_SERVICE=gmail, SMTP_USER=your_email@gmail.com, SMTP_PASS=your_gmail_app_password
# For custom SMTP (e.g. Brevo, SendGrid, Amazon SES, Mailgun):
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="SWAPIC" <noreply@swapic.in>
